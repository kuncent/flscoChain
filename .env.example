# ===== 全局环境配置 =====
# 链模式: mock | real
CHAIN_MODE=mock

# 后端
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 前端
VITE_API_BASE=http://localhost:8000

# FISCO-BCOS 节点（real 模式使用）
FISCO_RPC_HOST=127.0.0.1
FISCO_RPC_PORT=20200
FISCO_GROUP_ID=1
FISCO_CERT_DIR=./deploy/nodes/127.0.0.1/node0/conf

# 云桌面后端 SSH/执行器
CLOUD_DESKTOP_SHELL=/bin/bash

# JWT 鉴权（服务端签名密钥；留空时后端首次启动自动生成并写入 backend/.env）
JWT_SECRET=
# 开发调试兼容层：仅 true 时允许无 token 回退读旧 X-* 自报头（生产保持 false）
AUTH_DEV_HEADER_FALLBACK=false
