# ===== 链模式切换 =====
# fisco : 连接真实 FISCO-BCOS 节点（需先启动 deploy/docker-compose.yml）
# evm   : py-evm 进程内单例（默认，无需外部依赖）
# mock  : 内存模拟（兜底）
CHAIN_MODE=evm

# ===== FISCO-BCOS 节点连接（仅 CHAIN_MODE=fisco 时生效）=====
# 注意：fisco 模式下节点不可达/初始化失败会直接报错（不降级），请确保节点已启动。
# 起节点（4 节点）： docker compose -f deploy/docker-compose.yml up -d
FISCO_RPC_HOST=127.0.0.1
FISCO_RPC_PORT=8545
FISCO_GROUP_ID=1
# 链上 chainId（交易签名 v 字段）；留空时启动自动通过 getClientVersion 获取
FISCO_CHAIN_ID=
FISCO_CERT_DIR=

# ===== 后端服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 跨域白名单（CORS）=====
# 允许跨域访问 API 的前端来源（Origin）白名单，逗号分隔。
# 读取顺序（见 backend/app/main.py 的 _cors_origins）：环境变量 CORS_ORIGINS
# → backend/.env 中的 CORS_ORIGINS= 行 → 均未配置时默认仅允许
# http://localhost:5173 与 http://127.0.0.1:5173（本地开发地址）。
# 注意：
#   - 后端开启 allow_credentials=True，白名单不能配置 "*"，
#     否则浏览器会拒绝携带凭据的跨域请求；
#   - 局域网联调（同学用 http://<你的IP>:5173 访问你的机器）或经 Nginx 等
#     反向代理以域名部署时，必须把实际访问来源补充到下方白名单，
#     否则浏览器会因 CORS 拦截前端请求（控制台报 Access-Control-Allow-Origin 错误）；
#   - 来源需与浏览器地址栏完全一致：带协议与端口、不以 / 结尾。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173,https://demo.example.com

# ===== 跨专业综合实训平台 SSO（登录 / 智云 Token）=====
EXTERNAL_API_BASE=https://ecosim.sztzjy.com:166/server

# ===== JWT 鉴权 =====
# 服务端签名密钥：留空时首次启动会自动生成随机密钥并持久化到 .env；
# 生产环境请显式配置一个强随机值（如 openssl rand -base64 48）
JWT_SECRET=
# 开发调试兼容层：仅 true 时允许无 token 回退读旧 X-* 自报头（生产保持 false）
AUTH_DEV_HEADER_FALLBACK=false

# ===== 钱包密钥库 =====
# 账户私钥加密存储于 backend/app/storage/keystore.json（keystore v3 格式）。
# KEYSTORE_PASSWORD 为该密钥库的加密口令：
#   - 首次启动无密钥库时会自动生成演示账户并落盘；
#   - 未配置时使用开发兜底口令并输出告警日志（仅本地开发可用）；
#   - 生产/正式环境必须设置强口令，且一旦生成密钥库后请勿更换，
#     否则已有私钥将无法解密（可用 scripts/reset_demo_accounts.py 重置重建）。
KEYSTORE_PASSWORD=
